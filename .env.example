# Copy to .env and fill in with your Firebase project's web config
# (Firebase console → Project settings → General → Your apps → SDK setup).
# Until these are set, the app runs entirely on local demo data — see
# src/lib/firebase.ts (isFirebaseConfigured) and src/lib/store.ts.
#
# Required Firebase console setup:
#   1. Create a project, add a Web app to get this config.
#   2. Build > Authentication > Sign-in method > enable "Anonymous".
#   3. Build > Firestore Database > Create database.
#   4. Firestore > Rules > paste the contents of firestore.rules in this repo.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
